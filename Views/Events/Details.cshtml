@model EventRegistration.Models.Event

@{
    ViewData["Title"] = "Подробности мероприятия";
    
    // Считаем, сколько людей уже записалось (только со статусом "Активна")
    var activeRegistrationsCount = Model.Registrations?.Count(r => r.Status == "Активна") ?? 0;
    // Считаем свободные места
    var freeSeats = Model.Capacity - activeRegistrationsCount;
}

<h1>Подробности мероприятия</h1>

<!-- Блок вывода сообщений об успехе -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Название</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2">Дата</dt>
        <dd class="col-sm-10">@Model.Date.ToString("dd.MM.yyyy")</dd>

        <dt class="col-sm-2">Место</dt>
        <dd class="col-sm-10">@Model.Place</dd>

        <dt class="col-sm-2">Всего мест</dt>
        <dd class="col-sm-10">@Model.Capacity</dd>
        
        <dt class="col-sm-2">Свободных мест</dt>
        <dd class="col-sm-10">
            <strong>@freeSeats</strong>
        </dd>
    </dl>
</div>

<h3>Список участников</h3>

@if (Model.Registrations == null || !Model.Registrations.Any())
{
    <p>На это мероприятие пока никто не зарегистрирован.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ФИО</th>
                <th>Контакты</th>
                <th>Статус</th>
                <th>Действия</th> <!-- Новая колонка -->
            </tr>
        </thead>
        <tbody>
            @foreach (var reg in Model.Registrations)
            {
                <tr>
                    <td>@reg.Participant?.FullName</td>
                    <td>@reg.Participant?.ContactInfo</td>
                    <td>
                        @if (reg.Status == "Активна")
                        {
                            <span class="text-success">@reg.Status</span>
                        }
                        else
                        {
                            <span class="text-danger">@reg.Status</span>
                        }
                    </td>
                    <td>
                        @if (reg.Status == "Активна")
                        {
                            <!-- Форма для отмены регистрации -->
                            <form asp-action="CancelRegistration" asp-route-id="@reg.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Вы уверены, что хотите отменить регистрацию?');">Отменить</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a asp-action="Register" asp-route-id="@Model.Id" class="btn btn-primary">Зарегистрировать участника</a>
    <a asp-action="Index" class="btn btn-secondary">Назад к списку</a>
</div>