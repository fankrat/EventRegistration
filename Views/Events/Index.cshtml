@model List<EventRegistration.Models.Event>

@{
    ViewData["Title"] = "Мероприятия";
}

<h1>Список мероприятий</h1>

<!-- Блок поиска -->
<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group" style="max-width: 500px;">
        <input type="text" name="searchString" class="form-control" placeholder="Поиск по названию..." value="@ViewData["CurrentFilter"]" />
        <button type="submit" class="btn btn-primary">Найти</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Сбросить</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-success">Добавить мероприятие</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Название</th>
            <th>Дата</th>
            <th>Место</th>
            <th>Всего мест</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var ev in Model)
    {
        <tr>
            <td>@ev.Id</td>
            <td>@ev.Title</td>
            <td>@ev.Date.ToString("dd.MM.yyyy")</td>
            <td>@ev.Place</td>
            <td>@ev.Capacity</td>
            <td>
                <a asp-action="Register" asp-route-id="@ev.Id">Зарегистрировать</a> | 
                <a asp-action="Details" asp-route-id="@ev.Id">Подробнее</a> | 
                <a asp-action="Edit" asp-route-id="@ev.Id">Редактировать</a>
            </td>
        </tr>
    }
    </tbody>
</table>